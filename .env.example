# ==============================================================================
# DocuFlow AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the active .env file containing production secrets to version control.
# ==============================================================================

# Application Runtime Environment (development | staging | production | testing)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="DocuFlow AI"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Relational Database (PostgreSQL 16)
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow_dev_secret_change_in_prod
POSTGRES_DB=docuflow_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docuflow:docuflow_dev_secret_change_in_prod@postgres:5432/docuflow_db
# Sync URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://docuflow:docuflow_dev_secret_change_in_prod@postgres:5432/docuflow_db

# Redis & Celery Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=docuflow-documents
S3_REGION=us-east-1
S3_SECURE=false

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=docuflow_chunks

# Security & Authentication
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.openxmlformats-officedocument.presentationml.presentation","text/html","text/markdown","text/plain","image/png","image/jpeg","image/tiff"]

# Frontend Next.js Public Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="DocuFlow AI"
